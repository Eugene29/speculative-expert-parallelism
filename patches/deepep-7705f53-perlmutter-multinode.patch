+// NOTES: `addr` is a generic pointer into shared memory. With the `.shared::cta` state space, sm_80 code takes
+// it as a shared-window offset and faults ("Warp Out of range Address"), so Ampere builds use generic addressing.
 __forceinline__ __device__ int atomic_cas_cta_acquire(int* addr, int x, int y) {
     int ret;
+#ifndef DISABLE_SM90_FEATURES
     asm volatile("atom.acquire.cta.shared::cta.cas.b32 %0, [%1], %2, %3;" : "=r"(ret) : "l"(addr), "r"(x), "r"(y) : "memory");
+#else
+    asm volatile("atom.acquire.cta.cas.b32 %0, [%1], %2, %3;" : "=r"(ret) : "l"(addr), "r"(x), "r"(y) : "memory");
+#endif
     return ret;
 }
 
 __forceinline__ __device__ int atomic_exch_cta_release(int* addr, int x) {
     int ret;
+#ifndef DISABLE_SM90_FEATURES
     asm volatile("atom.release.cta.shared::cta.exch.b32 %0, [%1], %2;" : "=r"(ret) : "l"(addr), "r"(x) : "memory");
+#else
+    asm volatile("atom.release.cta.exch.b32 %0, [%1], %2;" : "=r"(ret) : "l"(addr), "r"(x) : "memory");
+#endif
     return ret;
 }
 
