diff --git a/csrc/kernels/generic_device.cuh b/csrc/kernels/generic_device.cuh
new file mode 100644
index 0000000..2a44189
--- /dev/null
+++ b/csrc/kernels/generic_device.cuh
@@ -0,0 +1,41 @@
+// Stand-ins for the helpers of `ibgda_device.cuh`, written with NVSHMEM's portable device API,
+// so the internode kernels run over any NVSHMEM remote transport (libfabric on Slingshot here).
+// NVSHMEM's host proxy thread sends each put. IBGDA keeps a counter add behind the payload that
+// precedes it on the same queue pair; here the fence after every put does that.
+#pragma once
+
+#include "configs.cuh"
+#include "exception.cuh"
+#include "utils.cuh"
+
+namespace deep_ep {
+
+// Called by a whole warp. `qp_id` and `message_idx` only matter to IBGDA.
+template <bool kAlwaysDoPostSend = false>
+__device__ static __forceinline__ void
+nvshmemi_ibgda_put_nbi_warp(uint64_t req_rptr, uint64_t req_lptr, size_t bytes, int dst_pe, int qp_id, int lane_id, int message_idx) {
+    nvshmemx_int8_put_nbi_warp(reinterpret_cast<int8_t*>(req_rptr), reinterpret_cast<const int8_t*>(req_lptr), bytes, dst_pe);
+    if (lane_id == 0)
+        nvshmem_fence();
+    __syncwarp();
+}
+
+// Called by one thread. The counters are 64-bit, as with IBGDA.
+__device__ __forceinline__ void nvshmemi_ibgda_amo_nonfetch_add(void* rptr, const int& value, int pe, int qp_id, bool is_local_copy = false) {
+    if (is_local_copy) {
+        atomicAdd(static_cast<unsigned long long*>(rptr), value);
+    } else {
+        nvshmemx_signal_op(static_cast<uint64_t*>(rptr), static_cast<uint64_t>(static_cast<int64_t>(value)), NVSHMEM_SIGNAL_ADD, pe);
+    }
+}
+
+// No peer is reachable by load/store here, so every other rank reports "use RDMA".
+__device__ __forceinline__ uint64_t nvshmemi_get_p2p_ptr(const uint64_t& ptr, const int& rank, const int& dst_rank) {
+    return rank == dst_rank ? ptr : 0;
+}
+
+__device__ static __forceinline__ void nvshmemi_ibgda_quiet(int dst_pe, int qp_id) {
+    nvshmem_quiet();
+}
+
+} // namespace deep_ep
